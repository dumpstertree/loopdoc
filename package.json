{
  "name": "loopdoc-composer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/styles.mjs --watch & vite",
    "styles": "node scripts/styles.mjs --gen",
    "harvest": "node scripts/styles.mjs",
    "build": "node scripts/styles.mjs --gen && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "cards": "esbuild --bundle --format=esm --outfile=dist/render-check.mjs scripts/render-check.jsx && node dist/render-check.mjs"
  },
  "dependencies": {
    "filbert": "^0.1.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
