{
  "app": "loopdoc-composer",
  "version": 1,
  "name": "Turn-Based RPG",
  "design": {
    "id": "g_root",
    "mode": "flow",
    "name": "Main Loop",
    "entry": "n_enc",
    "nodes": [
      { "id": "n_enc", "kind": "step", "name": "encounter", "x": 80, "y": 140, "note": "party stumbles into a room of monsters" },
      {
        "id": "n_combat",
        "kind": "machine",
        "name": "combat",
        "x": 380,
        "y": 100,
        "graph": {
          "id": "g_combat",
          "mode": "machine",
          "name": "combat",
          "entry": null,
          "nodes": [
            { "id": "t_note", "kind": "text", "name": "⚔ 1–3 players vs 1–6 enemies — set players & enemies pools before combat. Each turn click ⚔ ATTACK or ✨ MAGIC on a player's turn.", "x": 60, "y": 20 },

            { "id": "s_turn", "kind": "source", "name": "", "x": 60, "y": 120, "auto": true },
            { "id": "p_turn", "kind": "pool", "name": "turn", "x": 280, "y": 120, "init": 0 },

            { "id": "a_attack", "kind": "action", "name": "", "x": 520, "y": 40 },
            { "id": "p_atksig", "kind": "pool", "name": "attack signal", "x": 760, "y": 60, "init": 0 },

            { "id": "a_magic", "kind": "action", "name": "", "x": 520, "y": 240 },
            { "id": "p_spellsig", "kind": "pool", "name": "spell signal", "x": 760, "y": 240, "init": 0 },

            { "id": "s_mana", "kind": "source", "name": "", "x": 60, "y": 380, "auto": true },
            { "id": "p_mana", "kind": "pool", "name": "mana", "x": 280, "y": 380, "init": 6 },

            { "id": "p_power", "kind": "pool", "name": "attack power", "x": 60, "y": 540, "init": 10 },
            { "id": "p_enemies", "kind": "pool", "name": "enemies (1–6)", "x": 280, "y": 540, "init": 4 },
            { "id": "p_spellpow", "kind": "pool", "name": "spell power", "x": 520, "y": 540, "init": 25 },

            { "id": "x_roll", "kind": "syscall", "name": "", "x": 1000, "y": 40, "calls": [{ "asset": "sys_rpg", "fn": "fn_roll" }], "out": { "rd_dmg": 12 } },
            { "id": "p_hits", "kind": "pool", "name": "hit landed", "x": 1260, "y": 60, "init": 0 },

            { "id": "x_cast", "kind": "syscall", "name": "", "x": 1000, "y": 240, "calls": [{ "asset": "sys_rpg", "fn": "fn_cast" }], "out": { "cs_dmg": 25 } },
            { "id": "p_spland", "kind": "pool", "name": "spell landed", "x": 1260, "y": 240, "init": 0 },

            { "id": "p_ehp", "kind": "pool", "name": "enemy hp", "x": 640, "y": 700, "init": 60 },
            { "id": "c_hit", "kind": "drain", "name": "", "x": 940, "y": 660 },
            { "id": "c_spell", "kind": "drain", "name": "", "x": 940, "y": 800 },
            { "id": "p_slain", "kind": "pool", "name": "hp destroyed", "x": 1260, "y": 720, "init": 0 },

            { "id": "p_php", "kind": "pool", "name": "player hp (×players)", "x": 60, "y": 780, "init": 30 },
            { "id": "d_revenge", "kind": "drain", "name": "", "x": 360, "y": 800, "auto": true }
          ],
          "links": [
            { "id": "l1", "kind": "flow", "from": "s_turn", "fromPort": "out", "to": "p_turn", "toPort": "in", "amount": 1 },
            { "id": "l2", "kind": "flow", "from": "p_turn", "fromPort": "out", "to": "a_attack", "toPort": "in", "amount": 1 },
            { "id": "l3", "kind": "flow", "from": "p_turn", "fromPort": "out", "to": "a_magic", "toPort": "in", "amount": 1 },
            { "id": "l4", "kind": "flow", "from": "a_attack", "fromPort": "out", "to": "p_atksig", "toPort": "in", "amount": 1 },
            { "id": "l5", "kind": "flow", "from": "a_magic", "fromPort": "out", "to": "p_spellsig", "toPort": "in", "amount": 1 },

            { "id": "l6", "kind": "flow", "from": "s_mana", "fromPort": "out", "to": "p_mana", "toPort": "in", "amount": 1 },
            { "id": "l7", "kind": "flow", "from": "p_mana", "fromPort": "out", "to": "a_magic", "toPort": "in", "amount": 2 },

            { "id": "l8", "kind": "flow", "from": "p_atksig", "fromPort": "out", "to": "x_roll", "toPort": "in", "amount": 1 },
            { "id": "l9", "kind": "flow", "from": "x_roll", "fromPort": "out", "to": "p_hits", "toPort": "in", "amount": 1 },
            { "id": "l10", "kind": "flow", "from": "p_spellsig", "fromPort": "out", "to": "x_cast", "toPort": "in", "amount": 1 },
            { "id": "l11", "kind": "flow", "from": "x_cast", "fromPort": "out", "to": "p_spland", "toPort": "in", "amount": 1 },

            { "id": "l12", "kind": "flow", "from": "p_ehp", "fromPort": "out", "to": "c_hit", "toPort": "in", "amount": 12 },
            { "id": "l13", "kind": "flow", "from": "p_hits", "fromPort": "out", "to": "c_hit", "toPort": "in", "amount": 1 },
            { "id": "l14", "kind": "flow", "from": "c_hit", "fromPort": "out", "to": "p_slain", "toPort": "in", "amount": 12 },

            { "id": "l15", "kind": "flow", "from": "p_ehp", "fromPort": "out", "to": "c_spell", "toPort": "in", "amount": 25 },
            { "id": "l16", "kind": "flow", "from": "p_spland", "fromPort": "out", "to": "c_spell", "toPort": "in", "amount": 1 },
            { "id": "l17", "kind": "flow", "from": "c_spell", "fromPort": "out", "to": "p_slain", "toPort": "in", "amount": 25 },

            { "id": "l18", "kind": "flow", "from": "p_php", "fromPort": "out", "to": "d_revenge", "toPort": "in", "amount": 8 },

            { "id": "d1", "kind": "data", "from": "p_power", "fromPort": "__int__", "to": "x_roll", "toPort": "rd_p" },
            { "id": "d2", "kind": "data", "from": "p_enemies", "fromPort": "__int__", "to": "x_roll", "toPort": "rd_f" },
            { "id": "d3", "kind": "data", "from": "p_spellpow", "fromPort": "__int__", "to": "x_cast", "toPort": "cs_p" }
          ]
        }
      },
      { "id": "n_loot", "kind": "step", "name": "split loot", "x": 700, "y": 140, "note": "xp + gold shared among survivors" }
    ],
    "links": [
      { "id": "lc1", "kind": "flow", "from": "n_enc", "fromPort": "out", "to": "n_combat", "toPort": "in", "anchors": [] },
      { "id": "lc2", "kind": "flow", "from": "n_combat", "fromPort": "out", "to": "n_loot", "toPort": "in", "anchors": [] }
    ]
  },
  "notes": { "business": "", "mood": "" },
  "assets": [
    {
      "id": "sys_rpg",
      "kind": "system",
      "name": "rpg engine",
      "note": "combat math — damage rolls & spell effects",
      "api": [
        {
          "id": "fn_roll",
          "name": "roll_damage",
          "inputs": [
            { "id": "rd_p", "name": "power", "type": "int" },
            { "id": "rd_f", "name": "foes", "type": "int" }
          ],
          "outputs": [{ "id": "rd_dmg", "name": "damage", "type": "int" }]
        },
        {
          "id": "fn_cast",
          "name": "cast_spell",
          "inputs": [{ "id": "cs_p", "name": "power", "type": "int" }],
          "outputs": [{ "id": "cs_dmg", "name": "damage", "type": "int" }]
        }
      ]
    }
  ]
}
