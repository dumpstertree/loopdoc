{
  "app": "loopdoc-composer",
  "version": 1,
  "name": "Turn-Based RPG",
  "design": {
    "id": "g_root",
    "mode": "flow",
    "name": "Main Loop",
    "entry": "n_enc",
    "nodes": [
      { "id": "n_enc", "kind": "step", "name": "encounter", "x": 80, "y": 140, "note": "party stumbles into a room of monsters" },
      {
        "id": "n_combat",
        "kind": "machine",
        "name": "combat",
        "x": 380,
        "y": 100,
        "graph": {
          "id": "g_combat",
          "mode": "machine",
          "name": "combat",
          "entry": "e_turn",
          "nodes": [
            { "id": "t_note", "kind": "text", "name": "⚔ 1–3 players vs 1–6 enemies — each turn click ⚔ ATTACK or ✨ MAGIC on a player's turn.", "x": 60, "y": 20 },

            { "id": "e_turn", "kind": "enter", "name": "turn", "x": 60, "y": 120, "vars": [
              { "id": "v_pow", "name": "power", "type": "int" },
              { "id": "v_foes", "name": "foes", "type": "int" }
            ] },
            { "id": "st_turn", "kind": "step", "name": "whose turn", "x": 280, "y": 120 },

            { "id": "a_attack", "kind": "action", "name": "", "x": 520, "y": 40 },
            { "id": "a_magic", "kind": "action", "name": "", "x": 520, "y": 240 },

            { "id": "x_roll", "kind": "syscall", "name": "", "x": 1000, "y": 40, "calls": [{ "asset": "sys_rpg", "fn": "fn_roll" }], "out": { "rd_dmg": 12 } },
            { "id": "x_cast", "kind": "syscall", "name": "", "x": 1000, "y": 240, "calls": [{ "asset": "sys_rpg", "fn": "fn_cast" }], "out": { "cs_dmg": 25 } },

            { "id": "x_end", "kind": "exit", "name": "", "x": 1260, "y": 140 }
          ],
          "links": [
            { "id": "l1", "kind": "flow", "from": "e_turn", "fromPort": "out", "to": "st_turn", "toPort": "in", "anchors": [] },
            { "id": "l2", "kind": "flow", "from": "st_turn", "fromPort": "out", "to": "a_attack", "toPort": "in", "anchors": [] },
            { "id": "l3", "kind": "flow", "from": "st_turn", "fromPort": "out", "to": "a_magic", "toPort": "in", "anchors": [] },
            { "id": "l4", "kind": "flow", "from": "a_attack", "fromPort": "out", "to": "x_roll", "toPort": "in", "anchors": [] },
            { "id": "l5", "kind": "flow", "from": "a_magic", "fromPort": "out", "to": "x_cast", "toPort": "in", "anchors": [] },
            { "id": "l6", "kind": "flow", "from": "x_roll", "fromPort": "out", "to": "x_end", "toPort": "in", "anchors": [] },
            { "id": "l7", "kind": "flow", "from": "x_cast", "fromPort": "out", "to": "x_end", "toPort": "in", "anchors": [] },

            { "id": "d1", "kind": "data", "from": "e_turn", "fromPort": "v_pow", "to": "x_roll", "toPort": "rd_p" },
            { "id": "d2", "kind": "data", "from": "e_turn", "fromPort": "v_foes", "to": "x_roll", "toPort": "rd_f" },
            { "id": "d3", "kind": "data", "from": "e_turn", "fromPort": "v_pow", "to": "x_cast", "toPort": "cs_p" }
          ]
        }
      },
      { "id": "n_loot", "kind": "step", "name": "split loot", "x": 700, "y": 140, "note": "xp + gold shared among survivors" }
    ],
    "links": [
      { "id": "lc1", "kind": "flow", "from": "n_enc", "fromPort": "out", "to": "n_combat", "toPort": "in", "anchors": [] },
      { "id": "lc2", "kind": "flow", "from": "n_combat", "fromPort": "out", "to": "n_loot", "toPort": "in", "anchors": [] }
    ]
  },
  "notes": { "business": "", "mood": "" },
  "assets": [
    {
      "id": "sys_rpg",
      "kind": "system",
      "name": "rpg engine",
      "note": "combat math — damage rolls & spell effects",
      "api": [
        {
          "id": "fn_roll",
          "name": "roll_damage",
          "inputs": [
            { "id": "rd_p", "name": "power", "type": "int" },
            { "id": "rd_f", "name": "foes", "type": "int" }
          ],
          "outputs": [{ "id": "rd_dmg", "name": "damage", "type": "int" }]
        },
        {
          "id": "fn_cast",
          "name": "cast_spell",
          "inputs": [{ "id": "cs_p", "name": "power", "type": "int" }],
          "outputs": [{ "id": "cs_dmg", "name": "damage", "type": "int" }]
        }
      ]
    }
  ]
}
